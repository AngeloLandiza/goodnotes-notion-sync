# Notion -------------------------------------------------------------------
# https://www.notion.com/my-integrations -> internal integration -> token
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The assignments database id: the 32-hex chunk in its URL
NOTION_ASSIGNMENTS_DB=00000000000000000000000000000000
# The courses database id. Only the Canvas import needs this -- it joins
# Canvas courses to Notion ones on the "Code" property ("CS 411").
NOTION_COURSES_DB=00000000000000000000000000000000

# Google Drive -------------------------------------------------------------
# Google Cloud Console -> OAuth client ID -> "Desktop app"
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Produced by: python -m goodnotes_notion_sync auth
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GoodNotes auto-backup folder: id, share URL, or exact folder name.
# This is the id of the "GoodNotes" folder in Angelo's Drive.
GDRIVE_FOLDER_ID=1Y0qfNKgm0xHfMm8LegQ0sjTDL4RO-p56

# Canvas (optional) --------------------------------------------------------
# Canvas -> Account -> Settings -> New Access Token. This is a password: it can
# read everything your Canvas account can. Nothing here writes back to Canvas.
CANVAS_TOKEN=
# Your school's Canvas host. Bare hostname or full URL, either works.
CANVAS_BASE_URL=https://canvas.uic.edu
# Campus timezone, used to convert Canvas' UTC due dates.
CAMPUS_TIMEZONE=America/Chicago

# Vercel deployment only -------------------------------------------------
# Not used by the CLI. Generate both with: openssl rand -base64 32
# APP_TOKEN gates the dashboard; CRON_SECRET is what Vercel sends as the
# Authorization header on scheduled runs (you create it, Vercel does not).
APP_TOKEN=replace-me-with-a-long-random-string
CRON_SECRET=replace-me-with-a-long-random-string
